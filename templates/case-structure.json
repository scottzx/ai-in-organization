{
  "version": 2,
  "h1_format": "{id} {title}",
  "required_h2": [
    "1. 企业介绍",
    "2. 业务背景与改造目标",
    "3. 面临的问题",
    "4. 解决方案与实施过程",
    "5. 实施效果",
    "6. 分析与启示",
    "7. 资料来源"
  ],
  "editorial_placeholder_pattern": "待补(?:充)?(?:资料|信息|数据|内容)|待填写|^(?:[-+]\\s+)?(?:编辑提示[：:]\\s*)?(?:待补(?:充)?|需补充|待核实)(?:资料|信息|数据|内容)?\\s*[：:]"
}
