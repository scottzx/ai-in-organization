[Unit]
Description=Update the public AI transformation report mirror
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=reportmirror
Group=reportmirror
WorkingDirectory=/opt/ai-report-mirror
ExecStart=/opt/ai-report-mirror/venv/bin/python /opt/ai-report-mirror/update.py
Environment=PYTHONUNBUFFERED=1
Environment=REPORT_SITE_URL=https://www.dreammate.work/report/ai-transformation-2026/
UMask=0022
TimeoutStartSec=15min
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/ai-report-mirror /var/www/report.dreammate.work
